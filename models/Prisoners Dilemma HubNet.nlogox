    <slider x="330" step="1" y="139" max="5" display="D-C" height="33" min="-5" direction="Horizontal" default="5" variable="D-C" width="92" sizeVersion="0"/>
    <slider x="426" step="1" y="140" max="5" display="D-D" height="33" min="-5" direction="Horizontal" default="-3" variable="D-D" width="92" sizeVersion="0"/>
    <plot x="10" autoPlotX="true" yMax="10" autoPlotY="true" y="99" xMin="-1" height="302" legend="false" xMax="10" yMin="0" display="Strategies" width="298" sizeVersion="0">
      <setup/>
      <update/>
      <pen interval="1" mode="0" display="random" color="-16777216" legend="true">
        <setup/>
        <update/>
      </pen>
      <pen interval="1" mode="0" display="cooperate" color="-6459832" legend="true">
        <setup/>
        <update/>
      </pen>
      <pen interval="1" mode="0" display="defect" color="-13345367" legend="true">
        <setup/>
        <update/>
      </pen>
      <pen interval="1" mode="0" display="go-by-majority" color="-955883" legend="true">
        <setup/>
        <update/>
      </pen>
      <pen interval="1" mode="0" display="tit-for-tat" color="-11221820" legend="true">
        <setup/>
        <update/>
      </pen>
      <pen interval="1" mode="0" display="suspicious-tit-for-tat" color="-5825686" legend="true">
        <setup/>
        <update/>
      </pen>
      <pen interval="1" mode="0" display="tit-for-two-tats" color="-13840069" legend="true">
        <setup/>
        <update/>
      </pen>
      <pen interval="1" mode="0" display="pavlov" color="-1184463" legend="true">
        <setup/>
