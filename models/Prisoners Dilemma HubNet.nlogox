      </pen>
      <pen interval="1" mode="0" display="0" color="-16777216" legend="false">
        <setup/>
        <update>plotxy 0 0</update>
      </pen>
    </plot>
    <plot x="328" autoPlotX="true" yMax="10" autoPlotY="true" y="200" xMin="0" height="200" legend="false" xMax="10" yMin="0" display="C-D Plot" width="193" sizeVersion="0">
