    <view x="438" wrappingAllowedX="false" y="41" frameRate="30" minPycor="-10" height="534" showTickCounter="true" patchSize="25" fontSize="10" wrappingAllowedY="false" width="533" tickCounterLabel="ticks" maxPycor="10" updateMode="1" maxPxcor="10" minPxcor="-10"/>
