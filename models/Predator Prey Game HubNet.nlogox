      </polygon>
      <polygon color="-1920102913" filled="true" marked="true">
        <point x="285" y="120"/>
        <point x="270" y="90"/>
        <point x="285" y="15"/>
        <point x="300" y="15"/>
      </polygon>
      <line endX="105" startY="285" marked="true" color="-1920102913" endY="240" startX="15"/>
      <polygon color="-1920102913" filled="true" marked="true">
