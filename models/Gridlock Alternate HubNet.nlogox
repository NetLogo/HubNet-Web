  <widgets>
    <view x="566" wrappingAllowedX="true" y="96" frameRate="30" minPycor="-18" height="379" showTickCounter="false" patchSize="10" fontSize="10" wrappingAllowedY="true" width="378" tickCounterLabel="ticks" maxPycor="18" updateMode="1" maxPxcor="18" minPxcor="-18"/>
    <note x="4" y="400" height="63" textColorLight="-16777216" fontSize="11" width="275" markdown="false">This slider determines which plot is drawn.
0=no plots, 1=stopped cars
2=average speed, 3=average wait
4=all three plots</note>
    <slider x="1" step="1" y="464" max="4" display="display-which-metric" height="33" min="0" direction="Horizontal" default="4" variable="display-which-metric" width="165" sizeVersion="0"/>
    <plot x="565" autoPlotX="true" yMax="5" autoPlotY="true" yAxis="Average Wait" y="500" xMin="0" height="189" legend="false" xMax="100" yMin="0" xAxis="Time" display="Average Wait Time of Cars" width="279" sizeVersion="0">
      <setup/>
      <update/>
      <pen interval="1" mode="0" display="default" color="-2674135" legend="true">
        <setup/>
        <update/>
      </pen>
    </plot>
    <plot x="283" autoPlotX="true" yMax="1" autoPlotY="true" yAxis="Average Speed" y="500" xMin="0" height="189" legend="false" xMax="100" yMin="0" xAxis="Time" display="Average Speed of Cars" width="279" sizeVersion="0">
      <setup/>
      <update/>
      <pen interval="1" mode="0" display="default" color="-2674135" legend="true">
        <setup/>
        <update/>
      </pen>
    </plot>
    <button x="571" y="60" height="33" disableUntilTicks="false" forever="false" kind="Observer" display="Reset Instructions" width="118" sizeVersion="0">setup-quick-start</button>
    <button x="857" y="60" height="33" disableUntilTicks="false" forever="false" kind="Observer" display="NEXT &gt;&gt;&gt;" width="84" sizeVersion="0">view-next</button>
    <button x="780" y="60" height="33" disableUntilTicks="false" forever="false" kind="Observer" display="&lt;&lt;&lt; PREV" width="78" sizeVersion="0">view-prev</button>
    <monitor x="571" precision="0" y="10" height="45" fontSize="11" display="Quick Start Instructions- More in Info Window" width="370" sizeVersion="0">quick-start</monitor>
    <slider x="98" step="1" y="10" max="9" display="grid-size-y" height="33" min="1" direction="Horizontal" default="5" variable="grid-size-y" width="97" sizeVersion="0"/>
    <slider x="2" step="1" y="10" max="9" display="grid-size-x" height="33" min="1" direction="Horizontal" default="5" variable="grid-size-x" width="94" sizeVersion="0"/>
    <switch x="99" y="82" height="33" on="false" variable="auto?" display="auto?" width="90" sizeVersion="0"/>
    <switch x="191" y="82" height="33" on="false" variable="crash?" display="crash?" width="90" sizeVersion="0"/>
    <switch x="2" y="82" height="33" on="true" variable="power?" display="power?" width="95" sizeVersion="0"/>
    <slider x="2" step="1" y="46" max="400" display="number" height="33" min="0" direction="Horizontal" default="200" variable="number" units="cars" width="279" sizeVersion="0"/>
    <plot x="1" autoPlotX="true" yMax="100" autoPlotY="true" yAxis="Stopped Cars" y="500" xMin="0" height="189" legend="false" xMax="100" yMin="0" xAxis="Time" display="Stopped Cars" width="279" sizeVersion="0">
      <setup/>
      <update/>
      <pen interval="1" mode="0" display="default" color="-2674135" legend="true">
        <setup/>
        <update/>
      </pen>
    </plot>
